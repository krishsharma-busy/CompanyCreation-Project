<UserControl x:Class="Presentation.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Presentation.ViewModels">
    <UserControl.DataContext>
        <vm:MainMenuViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource PageBackground}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Company Project" 
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,40"/>

            <Button Content="Create Company" Command="{Binding CreateCompanyCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

            <Button Content="Load Company" Command="{Binding LoadCompanyCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Grid>
</UserControl>
